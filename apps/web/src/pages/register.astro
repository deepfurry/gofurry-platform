---
import AccountLayout from '../layouts/AccountLayout.astro';
import CredentialsForm from '../components/CredentialsForm';
import OAuthActions from '../components/OAuthActions.astro';
---
<AccountLayout title="Create your account" description="Make a place for yourself in the furry ecosystem.">
  <OAuthActions />
  <CredentialsForm mode="register" client:load />
  <noscript>Enable JavaScript to create an account securely.</noscript>
  <p>Already have an account? <a href="/login">Log in</a></p>
</AccountLayout>
