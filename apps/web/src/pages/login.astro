---
import AccountLayout from '../layouts/AccountLayout.astro';
import CredentialsForm from '../components/CredentialsForm';
---
<AccountLayout title="Welcome back" description="Log in to manage your GoFurry profile.">
  <CredentialsForm mode="login" client:load />
  <noscript>Enable JavaScript to log in securely.</noscript>
  <p>New here? <a href="/register">Create an account</a></p>
</AccountLayout>
